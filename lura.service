[Unit]
Description=Lura voice assistant (wake word listener)
Documentation=file:/var/www/html/lura/README.md
# The audio session, not just login: starting before PipeWire is up means no
# microphone and an immediate crash loop.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/var/www/html/lura/.venv/bin/lura run
Restart=on-failure
RestartSec=5
# 78 is EX_CONFIG: no API key, or no wake model. Restarting cannot fix either,
# so the service waits for a human rather than respawning forever.
RestartPreventExitStatus=78
# Give PipeWire a moment on a cold login before the first attempt.
ExecStartPre=/bin/sleep 3

Environment=PYTHONUNBUFFERED=1
Environment=XDG_RUNTIME_DIR=%t
Environment=DISPLAY=:0
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
PassEnvironment=DISPLAY WAYLAND_DISPLAY XAUTHORITY DBUS_SESSION_BUS_ADDRESS

ProtectHome=no
ProtectSystem=no

[Install]
WantedBy=graphical-session.target
