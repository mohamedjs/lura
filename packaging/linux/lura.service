[Unit]
Description=Lura voice assistant
Documentation=https://github.com/mohamedjs/lura
# The audio session, not just login: starting before PipeWire is up means no
# microphone and an immediate crash loop.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/opt/lura/LuraApp run --no-browser
Restart=on-failure
RestartSec=5
# 78 is EX_CONFIG: a human must fix something; restarting cannot.
RestartPreventExitStatus=78
# Give PipeWire a moment on a cold login.
ExecStartPre=/bin/sleep 3
Environment=PYTHONUNBUFFERED=1
# Without it sounddevice sees no audio devices under systemd.
Environment=XDG_RUNTIME_DIR=%t
PassEnvironment=DISPLAY WAYLAND_DISPLAY XAUTHORITY DBUS_SESSION_BUS_ADDRESS XDG_CURRENT_DESKTOP

[Install]
WantedBy=graphical-session.target
