# Homebrew Cask for Lura. The release workflow fills in the version and
# checksums and pushes this to the tap (mohamedjs/homebrew-lura):
#
#   brew install --cask mohamedjs/lura/lura
cask "lura" do
  arch arm: "arm64", intel: "x86_64"

  version "@VERSION@"
  sha256 arm:   "@SHA_ARM64@",
         intel: "@SHA_X86_64@"

  url "https://github.com/mohamedjs/lura/releases/download/v#{version}/Lura-#{version}-macos-#{arch}.zip"
  name "Lura"
  desc "Voice-first desktop assistant — Arabic and English"
  homepage "https://github.com/mohamedjs/lura"

  depends_on macos: ">= :monterey"
  # npx runs the built-in Chrome, web and files connectors.
  depends_on formula: "node"

  app "Lura.app"
  binary "#{appdir}/Lura.app/Contents/MacOS/lura"

  # Until the app is notarised (needs an Apple Developer ID), Gatekeeper
  # would refuse to open a downloaded, unsigned app.
  postflight do
    system_command "/usr/bin/xattr", args: ["-dr", "com.apple.quarantine", "#{appdir}/Lura.app"]
  end

  uninstall launchctl: "com.lura.assistant",
            quit:      "com.lura.assistant"

  zap trash: [
    "~/Library/Application Support/Lura",
    "~/Library/LaunchAgents/com.lura.assistant.plist",
  ]
end
